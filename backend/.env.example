# Copy this file to .env and fill in your own values.
# Never commit the actual .env file — it's already in .gitignore.

# Port the Express server runs on
PORT=5000

# MongoDB Atlas connection string
# Get this from: Atlas Dashboard -> Database -> Connect -> Drivers
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>
MONGO_URI=mongodb+srv://your_username:your_password@your-cluster.mongodb.net/bite-rush

# Secret key used to sign JWT auth tokens — use a long, random, unique string
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace_this_with_a_long_random_secret

# ---- Table booking + Razorpay (TEST mode only) ----
# Razorpay Dashboard (Test Mode) -> Account & Settings -> API Keys. Keys must start with rzp_test_.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
# Any long random string; paste the SAME value in Razorpay Dashboard -> Webhooks.
RAZORPAY_WEBHOOK_SECRET=another_long_random_string

# Optional tuning (defaults shown)
# BOOKING_HOLD_MINUTES=2
# BOOKING_DEPOSIT_RUPEES=100

# Local development ONLY, and only when Razorpay keys are NOT set. Never set this on Render.
# BOOKING_MOCK_PAYMENT=true
